# Copy to .env and fill in real values before running docker compose.

DB_PASSWORD=Change_Me_123!
# Optional override — defaults to the sqlserver container above if unset.
# DB_CONNECTION_STRING=Server=sqlserver;Database=ECommerceDB;User Id=sa;Password=Change_Me_123!;TrustServerCertificate=True;

JWT_KEY=replace-with-a-long-random-secret
JWT_ISSUER=https://your-api-domain
JWT_AUDIENCE=https://your-api-domain

VENDOR_PORTAL_ORIGIN=https://vendor.your-domain.com
ECOMMERCE_STORE_ORIGIN=https://your-domain.com

# Hostnames (no scheme, no port) the vendor-portal SSR server will accept requests
# for — Angular rejects any other Host header as a possible SSRF attempt.
VENDOR_PORTAL_ALLOWED_HOSTS=vendor.your-domain.com

# The URL vendor-portal's browser AND server-rendered code both call for API requests.
# In a real deployment use the real public API domain (e.g. https://api.your-domain.com) —
# it must be reachable both from the visitor's browser and from inside the vendor-portal
# container itself. Note: for a pure local docker-compose smoke test (no real domain),
# http://localhost:8080 works for the browser but NOT for calls made from inside the
# vendor-portal container during server-side rendering, since "localhost" there means the
# container itself, not the api container — that's a local-testing-only limitation.
API_BASE_URL=https://api.your-domain.com
